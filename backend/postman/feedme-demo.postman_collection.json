          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"authorId\": \"{{authorId}}\",\n  \"content\": \"This content should conflict with the previous request\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      }
    }
  ],
